<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>公众号排版助手</title>
  <style>
    :root {
      --bg: #f6f7fb;
      --panel: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --primary: #1aad19;
      --primary-dark: #159514;
      --border: #e5e7eb;
      --code-bg: #111827;
      --shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
      --radius: 18px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: radial-gradient(circle at top left, rgba(26,173,25,.12), transparent 28%), var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    }
    header {
      padding: 28px 36px 18px;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
    }
    .title-wrap h1 {
      margin: 0 0 8px;
      font-size: 26px;
      letter-spacing: -0.02em;
    }
    .title-wrap p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
      max-width: 760px;
      font-size: 14px;
    }
    .badge {
      flex: 0 0 auto;
      background: #ecfdf3;
      color: #087f23;
      border: 1px solid #c7f0d0;
      border-radius: 999px;
      padding: 8px 13px;
      font-size: 13px;
      font-weight: 600;
    }
    main {
      padding: 0 28px 28px;
      display: grid;
      grid-template-columns: minmax(320px, 1fr) minmax(320px, 1fr);
      gap: 20px;
      min-height: calc(100vh - 120px);
    }
    .card {
      background: rgba(255,255,255,.92);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-height: 620px;
    }
    .card-head {
      padding: 16px 18px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: rgba(249,250,251,.9);
    }
    .card-head h2 {
      margin: 0;
      font-size: 16px;
    }
    .sub {
      color: var(--muted);
      font-size: 12px;
    }
    textarea {
      flex: 1;
      width: 100%;
      border: 0;
      outline: none;
      resize: none;
      background: var(--code-bg);
      color: #e5e7eb;
      padding: 18px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
      font-size: 13px;
      line-height: 1.7;
      tab-size: 2;
    }
    .toolbar {
      padding: 14px 18px;
      border-top: 1px solid var(--border);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      background: #fff;
    }
    button {
      border: 0;
      border-radius: 12px;
      padding: 10px 14px;
      cursor: pointer;
      font-weight: 700;
      font-size: 14px;
      transition: .18s ease;
    }
    button.primary {
      background: var(--primary);
      color: #fff;
    }
    button.primary:hover { background: var(--primary-dark); }
    button.ghost {
      background: #f3f4f6;
      color: #374151;
    }
    button.ghost:hover { background: #e5e7eb; }
    .switch {
      margin-left: auto;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--muted);
      font-size: 13px;
      user-select: none;
    }
    .switch input { accent-color: var(--primary); }
    #previewWrap {
      flex: 1;
      overflow: auto;
      background: #f3f4f6;
      padding: 18px;
    }
    #preview {
      margin: 0 auto;
      max-width: 677px;
      min-height: 100%;
      background: #fff;
      border-radius: 8px;
      padding: 28px 24px;
      box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
      outline: none;
      overflow-wrap: break-word;
      color: #222;
      font-size: 16px;
      line-height: 1.75;
    }
    #preview img { max-width: 100%; height: auto; display: block; margin: 12px auto; }
    #preview p { margin: 0 0 1em; }
    #preview h1, #preview h2, #preview h3 { line-height: 1.35; }
    .notice {
      padding: 12px 18px;
      border-top: 1px solid var(--border);
      background: #fffbeb;
      color: #92400e;
      font-size: 13px;
      line-height: 1.6;
    }
    .status {
      min-height: 20px;
      color: #047857;
      font-size: 13px;
      font-weight: 600;
    }
    .placeholder {
      color: #9ca3af;
      text-align: center;
      padding: 80px 20px;
      border: 1px dashed #d1d5db;
      border-radius: 14px;
      background: #fafafa;
    }

    .top-actions {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      flex-shrink: 0;
    }
    .wechat-card {
      width: 104px;
      padding: 8px;
      border: 1px solid rgba(229, 231, 235, .9);
      border-radius: 14px;
      background: rgba(255, 255, 255, .86);
      box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
      text-align: center;
      color: var(--muted);
      backdrop-filter: blur(10px);
    }
    .wechat-card img {
      display: block;
      width: 72px;
      height: 72px;
      margin: 0 auto 5px;
      object-fit: cover;
      border-radius: 8px;
    }
    .wechat-card span {
      display: block;
      font-size: 11px;
      line-height: 1.25;
      letter-spacing: .01em;
    }
    .copy-helper {
      margin-top: 8px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.6;
    }
    .rich-copy-buffer {
      position: fixed;
      left: -10000px;
      top: 0;
      width: 760px;
      min-height: 10px;
      opacity: 0;
      pointer-events: none;
      background: #fff;
    }

    @media (max-width: 900px) {
      header { padding: 22px 18px 12px; flex-direction: column; }
      main { grid-template-columns: 1fr; padding: 0 14px 18px; }
      .card { min-height: 520px; }
    }
  </style>
</head>
<body>
  <header>
    <div class="title-wrap">
      <h1>富文本转换助手</h1>
      <p>把 HTML 或 Markdown 粘到左侧，选择对应格式后生成右侧富文本；点击“复制富文本到公众号”，再到微信公众号编辑器中粘贴。工具会自动移除 script、iframe 等风险标签，并尽量把样式内联，提升公众号粘贴后的保留率。</p>
    </div>
    <div class="top-actions">
      <div class="badge">本地运行 · 不上传内容</div>
      <div class="wechat-card" aria-label="微信二维码">
        <img src="data:image/jpeg;base64," alt="微信二维码" />
        <span>欢迎感兴趣的朋友加我交流</span>
      </div>
    </div>
  </header>

  <main>
    <section class="card">
      <div class="card-head">
        <div>
          <h2>1. 粘贴内容</h2>
          <div class="sub">支持 HTML 源码和 Markdown 文本；选择格式后，右侧会生成可复制的富文本效果。</div>
        </div>
      </div>

      <div style="padding: 14px 18px 0; display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
        <span style="font-size: 13px; color: #6b7280; font-weight: 700;">输入格式</span>
        <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:#374151;cursor:pointer;">
          <input type="radio" name="inputMode" value="html" checked style="accent-color:#1aad19;"> HTML
        </label>
        <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:#374151;cursor:pointer;">
          <input type="radio" name="inputMode" value="markdown" style="accent-color:#1aad19;"> Markdown / MD
        </label>
      </div>

      <textarea id="source" spellcheck="false"><section style="font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; color: #333; line-height: 1.8; font-size: 16px;">
  <p>把你的 HTML 或 Markdown 内容粘贴到左侧。</p>
  <p style="background: #f6ffed; border: 1px solid #b7eb8f; border-radius: 10px; padding: 12px 14px;">选择对应格式后，点击“生成富文本预览”，再复制到公众号后台。</p>
  <blockquote style="margin: 18px 0; padding: 10px 16px; color: #666; border-left: 4px solid #ddd; background: #fafafa;">提示：公众号编辑器会过滤部分 CSS 和外链资源，最终效果以公众号后台为准。</blockquote>
</section></textarea>

      <div class="toolbar">
        <button class="primary" id="renderBtn">生成富文本预览</button>
        <button class="ghost" id="clearBtn">清空</button>
        <label class="switch" title="将当前渲染后的计算样式写入内联 style，提升复制到公众号后的样式保留率。">
          <input type="checkbox" id="inlineStyle" checked /> 复制时内联样式
        </label>
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <div>
          <h2>2. 预览并复制</h2>
          <div class="sub">右侧是转换后的富文本效果；复制后到微信公众号编辑器直接粘贴。</div>
        </div>
      </div>
      <div class="preview-wrap">
        <div id="preview" class="preview" contenteditable="true"></div>
        <div id="resultInfo" class="status">等待生成预览</div>
      </div>
      <div class="toolbar">
        <button class="primary" id="copyBtn">复制富文本到公众号</button>
        <button class="ghost" id="selectBtn">手动全选预览</button>
        <button class="ghost" id="downloadBtn">下载转换后 HTML</button>
      </div>
    </section>
  </main>

<script>
    const source = document.getElementById('source');
    const preview = document.getElementById('preview');
    const resultInfo = document.getElementById('resultInfo');
    const inlineStyle = document.getElementById('inlineStyle');
    const modeRadios = Array.from(document.querySelectorAll('input[name="inputMode"]'));

    const sampleHtml = `<section style="font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; color: #333; line-height: 1.8; font-size: 16px;">
  <p>把你的 HTML 或 Markdown 内容粘贴到左侧。</p>
  <p style="background: #f6ffed; border: 1px solid #b7eb8f; border-radius: 10px; padding: 12px 14px;">选择对应格式后，点击“生成富文本预览”，再复制到公众号后台。</p>
  <blockquote style="margin: 18px 0; padding: 10px 16px; color: #666; border-left: 4px solid #ddd; background: #fafafa;">提示：公众号编辑器会过滤部分 CSS 和外链资源，最终效果以公众号后台为准。</blockquote>
</section>`;

    const sampleMarkdown = `## 小标题示例

把 Markdown 内容粘贴到这里，也可以直接生成公众号可复制的富文本。

- 支持标题、段落、引用和列表
- 支持 **加粗**、*强调*、\`行内代码\`
- 支持链接：[示例链接](https://example.com)

> 提示：生成后请在公众号后台再检查一次最终效果。`;

    function getMode() {
      return (modeRadios.find(r => r.checked) || {}).value || 'html';
    }

    function setStatus(message, ok = true) {
      resultInfo.textContent = message;
      resultInfo.style.color = ok ? '#166534' : '#b91c1c';
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function inlineMarkdown(text) {
      let s = escapeHtml(text);
      s = s.replace(/`([^`]+)`/g, '<code style="font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background:#f3f4f6; border-radius:4px; padding:1px 5px; color:#374151;">$1</code>');
      s = s.replace(/\*\*([^*]+)\*\*/g, '<strong style="font-weight:700;color:#111827;">$1</strong>');
      s = s.replace(/__([^_]+)__/g, '<strong style="font-weight:700;color:#111827;">$1</strong>');
      s = s.replace(/\*([^*]+)\*/g, '<em style="font-style:italic;">$1</em>');
      s = s.replace(/_([^_]+)_/g, '<em style="font-style:italic;">$1</em>');
      s = s.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" style="color:#2563eb;text-decoration:none;">$1</a>');
      return s;
    }

    function flushList(items, ordered) {
      if (!items.length) return '';
      const tag = ordered ? 'ol' : 'ul';
      const pad = ordered ? 'padding-left: 22px;' : 'padding-left: 20px;';
      const body = items.map(item => `<li style="margin: 4px 0; line-height: 1.8;">${inlineMarkdown(item)}</li>`).join('');
      return `<${tag} style="margin: 10px 0 16px; ${pad}">${body}</${tag}>`;
    }

    function markdownToHtml(md) {
      const lines = String(md || '').replace(/\r\n/g, '\n').split('\n');
      let html = [];
      let paragraph = [];
      let list = [];
      let ordered = false;
      let inCode = false;
      let codeLines = [];

      function flushParagraph() {
        if (paragraph.length) {
          html.push(`<p style="margin: 0 0 14px; line-height: 1.85; color:#333;">${inlineMarkdown(paragraph.join(' '))}</p>`);
          paragraph = [];
        }
      }
      function flushCurrentList() {
        if (list.length) {
          html.push(flushList(list, ordered));
          list = [];
        }
      }

      lines.forEach(raw => {
        const line = raw.trim();
        if (/^```/.test(line)) {
          flushParagraph();
          flushCurrentList();
          if (inCode) {
            html.push(`<pre style="white-space:pre-wrap; background:#f8fafc; border:1px solid #e5e7eb; border-radius:10px; padding:12px 14px; margin:12px 0 16px; color:#374151; font-size:13px; line-height:1.7;">${escapeHtml(codeLines.join('\n'))}</pre>`);
            codeLines = [];
            inCode = false;
          } else {
            inCode = true;
          }
          return;
        }
        if (inCode) {
          codeLines.push(raw);
          return;
        }
        if (!line) {
          flushParagraph();
          flushCurrentList();
          return;
        }
        const heading = line.match(/^(#{1,6})\s+(.+)$/);
        if (heading) {
          flushParagraph();
          flushCurrentList();
          const level = heading[1].length;
          const content = inlineMarkdown(heading[2]);
          if (level <= 2) {
            html.push(`<h2 style="font-size:20px; line-height:1.45; color:#111827; margin: 24px 0 12px; padding-left: 12px; border-left: 4px solid #1aad19; font-weight:700;">${content}</h2>`);
          } else {
            html.push(`<h3 style="font-size:17px; line-height:1.5; color:#111827; margin: 20px 0 10px; font-weight:700;">${content}</h3>`);
          }
          return;
        }
        const quote = line.match(/^>\s?(.+)$/);
        if (quote) {
          flushParagraph();
          flushCurrentList();
          html.push(`<blockquote style="margin: 14px 0 16px; padding: 10px 14px; color:#4b5563; border-left:4px solid #d1d5db; background:#f9fafb; border-radius:0 8px 8px 0;">${inlineMarkdown(quote[1])}</blockquote>`);
          return;
        }
        const unordered = line.match(/^[-*+]\s+(.+)$/);
        const orderedLine = line.match(/^\d+\.\s+(.+)$/);
        if (unordered || orderedLine) {
          flushParagraph();
          const nextOrdered = !!orderedLine;
          if (list.length && ordered !== nextOrdered) flushCurrentList();
          ordered = nextOrdered;
          list.push((unordered || orderedLine)[1]);
          return;
        }
        flushCurrentList();
        paragraph.push(line);
      });

      flushParagraph();
      flushCurrentList();
      if (inCode && codeLines.length) {
        html.push(`<pre style="white-space:pre-wrap; background:#f8fafc; border:1px solid #e5e7eb; border-radius:10px; padding:12px 14px; margin:12px 0 16px; color:#374151; font-size:13px; line-height:1.7;">${escapeHtml(codeLines.join('\n'))}</pre>`);
      }
      return `<section style="font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif; color:#333; line-height:1.8; font-size:16px;">${html.join('\n')}</section>`;
    }

    function sanitizeHtml(html) {
      const template = document.createElement('template');
      template.innerHTML = html;
      const blockedTags = ['script', 'iframe', 'object', 'embed', 'form', 'input', 'button', 'textarea', 'select', 'link', 'meta'];
      template.content.querySelectorAll(blockedTags.join(',')).forEach(node => node.remove());
      template.content.querySelectorAll('*').forEach(el => {
        [...el.attributes].forEach(attr => {
          const name = attr.name.toLowerCase();
          const value = attr.value || '';
          if (name.startsWith('on')) el.removeAttribute(attr.name);
          if ((name === 'href' || name === 'src') && /^\s*javascript:/i.test(value)) el.removeAttribute(attr.name);
          if ((name === 'href' || name === 'src') && /^\s*data:text\/html/i.test(value)) el.removeAttribute(attr.name);
          if (name === 'style' && /expression\s*\(|url\s*\(\s*javascript:/i.test(value)) el.removeAttribute(attr.name);
        });
      });
      return template.innerHTML.trim();
    }

    function getConvertedHtml() {
      const raw = source.value.trim();
      if (!raw) return '';
      return getMode() === 'markdown' ? markdownToHtml(raw) : raw;
    }

    function render() {
      const raw = source.value.trim();
      if (!raw) {
        preview.innerHTML = '<p style="color:#999;">请先在左侧粘贴 HTML 或 Markdown 内容。</p>';
        setStatus('没有可预览的内容', false);
        return;
      }
      const converted = getConvertedHtml();
      const clean = sanitizeHtml(converted);
      preview.innerHTML = clean || '<p style="color:#999;">内容为空或已被安全过滤。</p>';
      const modeLabel = getMode() === 'markdown' ? 'Markdown' : 'HTML';
      setStatus(`已按 ${modeLabel} 格式生成预览，可复制富文本。`);
    }

    function inlineComputedStyles(root) {
      const clone = root.cloneNode(true);
      const sourceNodes = [root, ...root.querySelectorAll('*')];
      const cloneNodes = [clone, ...clone.querySelectorAll('*')];
      sourceNodes.forEach((src, index) => {
        const dest = cloneNodes[index];
        if (!dest || dest.nodeType !== 1) return;
        const style = window.getComputedStyle(src);
        const props = ['font-family','font-size','font-weight','font-style','line-height','color','background-color','text-align','margin','margin-top','margin-right','margin-bottom','margin-left','padding','padding-top','padding-right','padding-bottom','padding-left','border','border-left','border-radius','display','list-style-type','text-decoration'];
        const inline = props.map(prop => `${prop}:${style.getPropertyValue(prop)}`).join(';');
        const old = dest.getAttribute('style') || '';
        dest.setAttribute('style', old ? `${old};${inline}` : inline);
      });
      return clone;
    }

    async function copyRichText() {
      if (!preview.innerHTML.trim()) render();
      const holder = document.createElement('div');
      const node = inlineStyle.checked ? inlineComputedStyles(preview) : preview.cloneNode(true);
      holder.appendChild(node);
      const html = holder.innerHTML;
      const text = preview.innerText;

      try {
        if (navigator.clipboard && window.ClipboardItem) {
          await navigator.clipboard.write([
            new ClipboardItem({
              'text/html': new Blob([html], { type: 'text/html' }),
              'text/plain': new Blob([text], { type: 'text/plain' })
            })
          ]);
          setStatus('已复制富文本。请到微信公众号编辑器中粘贴。');
          return;
        }
      } catch (err) {}

      const range = document.createRange();
      range.selectNodeContents(preview);
      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(range);
      const ok = document.execCommand('copy');
      selection.removeAllRanges();
      setStatus(ok ? '已复制富文本。请到微信公众号编辑器中粘贴。' : '自动复制失败，请点击“手动全选预览”后复制。', ok);
    }

    function selectPreview() {
      render();
      const range = document.createRange();
      range.selectNodeContents(preview);
      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(range);
      setStatus('已选中右侧预览内容，可按 Ctrl/Cmd + C 复制。');
    }

    function buildWechatHtml() {
      const clean = sanitizeHtml(getConvertedHtml());
      return `<!doctype html>\n<html lang="zh-CN">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n<title>转换后 HTML</title>\n</head>\n<body>\n${clean}\n</body>\n</html>`;
    }

    function downloadCleanHtml() {
      const html = buildWechatHtml();
      const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = getMode() === 'markdown' ? 'markdown-to-wechat-richtext.html' : 'clean-wechat-richtext.html';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(a.href);
      setStatus('已下载转换后的 HTML 文件。');
    }

    document.getElementById('renderBtn').addEventListener('click', render);
    document.getElementById('copyBtn').addEventListener('click', copyRichText);
    document.getElementById('selectBtn').addEventListener('click', selectPreview);
    document.getElementById('downloadBtn').addEventListener('click', downloadCleanHtml);
    document.getElementById('clearBtn').addEventListener('click', () => {
      source.value = '';
      preview.innerHTML = '';
      setStatus('已清空，等待生成预览。');
    });
    modeRadios.forEach(radio => radio.addEventListener('change', () => {
      source.value = getMode() === 'markdown' ? sampleMarkdown : sampleHtml;
      render();
    }));

    render();
  </script>
</body>
</html>
